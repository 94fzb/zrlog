# Required. Replace this value before starting the stack.
MYSQL_PASSWORD=

# Optional image and runtime overrides.
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=zrlog
MYSQL_USER=zrlog
ZRLOG_IMAGE=zrlog/zrlog:3.9.2
ZRLOG_BIND_ADDRESS=0.0.0.0
ZRLOG_PORT=8080

# Optional UI upgrades: use docker-compose.updater.yml after installing a release
# that includes the updater integration. All three images can use accessible registries.
# ZRLOG_IMAGE=registry.cn-chengdu.aliyuncs.com/hibegin/zrlog:<published-version>
# MYSQL_IMAGE=<accessible-mysql-image>
# Keep the EXISTING project name when adding the updater to an installed site.
# COMPOSE_PROJECT_NAME=your-existing-project
# ZRLOG_DEPLOYMENT_DIR=/absolute/host/path/to/deployment
# ZRLOG_UPDATER_TOKEN=<at-least-32-random-url-safe-characters>
# ZRLOG_UPDATER_IMAGE=registry.cn-chengdu.aliyuncs.com/hibegin/zrlog-updater:<published-version>
# ZRLOG_COMPOSE_FILES=docker-compose.yml,docker-compose.updater.yml
