# Copy this file to .env beside docker-compose.yml; maintain deployment values
# here instead of editing the YAML. Do not commit the populated .env.
# Required. Replace this value before starting the stack.
MYSQL_PASSWORD=

# Image and runtime settings. Keep these entries in .env even at their defaults.
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=zrlog
MYSQL_USER=zrlog
ZRLOG_IMAGE=zrlog/zrlog:3.9.2
ZRLOG_BIND_ADDRESS=0.0.0.0
ZRLOG_PORT=8080

# Updater is included in the default Compose file. UI upgrades also need an
# application version containing the integration; the default 3.9.2 does not.
# For a NEW site you may choose "zrlog". For an EXISTING site keep its exact project name.
COMPOSE_PROJECT_NAME=
# Absolute host directory containing this .env and docker-compose.yml.
ZRLOG_DEPLOYMENT_DIR=
# Generate a token with: openssl rand -hex 32
ZRLOG_UPDATER_TOKEN=
ZRLOG_UPDATER_IMAGE=registry.cn-chengdu.aliyuncs.com/hibegin/zrlog-updater:1.0.0-preview.1ef3c8e7cd37.38146772016.1
ZRLOG_COMPOSE_FILES=docker-compose.yml

# All three images accept a complete reference from a registry you can reach.
# ZRLOG_IMAGE=registry.cn-chengdu.aliyuncs.com/hibegin/zrlog:<published-version>
# MYSQL_IMAGE=<accessible-mysql-image>
# ZRLOG_UPDATER_IMAGE=zrlog/zrlog-updater:1.0.0-preview.1ef3c8e7cd37.38146772016.1
# The overlay is only needed when integrating an older/custom Compose file:
# ZRLOG_COMPOSE_FILES=docker-compose.yml,docker-compose.updater.yml
